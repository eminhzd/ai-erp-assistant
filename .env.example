# Copy this file to `.env` and replace the placeholder with your real connection string.

# PostgreSQL connection string (Neon, local, etc.)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Google AI Studio / Gemini API key
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# NextAuth secret — random string, e.g.:
# openssl rand -base64 32
AUTH_SECRET=
